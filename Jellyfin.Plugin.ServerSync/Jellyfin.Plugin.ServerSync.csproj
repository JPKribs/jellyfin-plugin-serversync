<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ServerSync</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305;CA2213;CA3003</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.2.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.2.0">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Sdk" Version="2026.10.12" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="2026.10.19" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sync page (main entry, default tab) -->
    <EmbeddedResource Include="Configuration\serversync_sync.html" />
    <EmbeddedResource Include="Configuration\serversync_sync.js" />
    <EmbeddedResource Include="Configuration\serversync_sync_table.js" />
    <EmbeddedResource Include="Configuration\serversync_sync_content.js" />
    <EmbeddedResource Include="Configuration\serversync_sync_history.js" />
    <EmbeddedResource Include="Configuration\serversync_sync_metadata.js" />
    <EmbeddedResource Include="Configuration\serversync_sync_users.js" />
    <EmbeddedResource Include="Configuration\serversync_sync_people.js" />
    <EmbeddedResource Include="Configuration\serversync_sync_queue.js" />
    <!-- Servers page -->
    <EmbeddedResource Include="Configuration\serversync_servers.html" />
    <EmbeddedResource Include="Configuration\serversync_servers.js" />
    <!-- Settings page -->
    <EmbeddedResource Include="Configuration\serversync_settings.html" />
    <EmbeddedResource Include="Configuration\serversync_settings.js" />
    <!-- Shared resources -->
    <EmbeddedResource Include="Configuration\serversync_shared.css" />
    <EmbeddedResource Include="Configuration\serversync_shared.js" />
  </ItemGroup>

</Project>
