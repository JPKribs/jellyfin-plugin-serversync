<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ServerSync</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <NoWarn>NU1605;CA1002;CA2227;CA1305;CA2213;CA3003</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc4">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0-rc4">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc4">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Sdk" Version="2025.10.21" />
    <!-- Pinned ahead of the version Jellyfin.Sdk asks for. 1.20.1 carries GHSA-7j59-v9qr-6fq9, patched in 1.22.0. -->
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.2" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="JPKribs.Jellyfin.Base" Version="2026.7.31" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sync page (main entry, default tab) -->
    <EmbeddedResource Include="Configuration\serversync_sync.html" />
    <EmbeddedResource Include="Configuration\serversync_sync.js" />
    <!-- Settings page -->
    <EmbeddedResource Include="Configuration\serversync_settings.html" />
    <EmbeddedResource Include="Configuration\serversync_settings.js" />
    <!-- Shared resources -->
    <EmbeddedResource Include="Configuration\serversync_shared.css" />
    <EmbeddedResource Include="Configuration\serversync_shared.js" />
  </ItemGroup>

</Project>
